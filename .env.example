# 한국관광공사 두루누비 정보 서비스 (Durunubi)
DURUNUBI_API_KEY=여기에_공공데이터포털_인증키를_입력하세요
DURUNUBI_ENDPOINT=https://apis.data.go.kr/B551011/Durunubi

# (선택) 한국관광공사 국문 관광정보 (KorService2, 사진 연동용 - 미설정 시 DURUNUBI_API_KEY 자동 사용)
# TOUR_API_KEY=
# TOUR_API_ENDPOINT=https://apis.data.go.kr/B551011/KorService2

# Gemini API 설정
GEMINI_API_KEY=여기에_Gemini_API_키를_입력하세요
GEMINI_MODEL=gemini-3.1-flash-lite

# Instagram Graph API 자동 게시 설정 (@trailllog)
IG_USER_ID=여기에_인스타그램_비즈니스_계정_ID를_입력하세요
IG_ACCESS_TOKEN=여기에_Meta_Graph_API_액세스_토큰을_입력하세요
IG_GRAPH_VERSION=v24.0

# GitHub 공개 이미지 호스팅 설정 (Meta API용 HTTPS 이미지 URL 제공)
GITHUB_TOKEN=여기에_GitHub_PAT를_입력하세요
GITHUB_REPO=kkubunge/Instagram_TrailLog
GITHUB_MEDIA_BRANCH=media-assets
